# === APIShort (yang sudah kamu daftar, Free 100 req/day) ===
# JANGAN isi key asli di file ini. Copy file ini jadi .env.local, lalu isi di sana.
# Key kamu ada di https://apishort.com/dashboard — tombol Copy Key.
# JANGAN pernah kirim key ini ke chat / commit ke GitHub.
APISHORT_API_KEY=vbs_paste_key_kamu_di_sini

# Base URL APIShort. Jangan diubah kecuali mau pindah provider API.
DRAMA_API_BASE_URL=https://apishort.com

# === DramaBos (CADANGAN, Free 1.000 request/bulan) ===
# Daftar dulu di https://dramabos.live/register, ambil key di dashboard.
# Tanpa key ini, fallback DramaBos TIDAK aktif (endpoint-nya 404 tanpa auth).
# Kalau key ini kosong, aplikasi tetap jalan penuh pakai APIShort saja.
DRAMABOS_API_KEY=paste_key_dramabos_di_sini
DRAMABOS_BASE_URL=https://dramabos.live

# Bahasa default: id = Indonesia
DRAMA_LANG=id

# Provider default. Pilihan yang sudah terverifikasi jalan di APIShort:
# shortmax (paling lengkap, dubbing Indo), dramabox, reelshort, netshort, flickreels
DEFAULT_PROVIDER=shortmax
